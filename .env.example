# MongoDB Atlas connection string (official driver — no Prisma)
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/skill-gap?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/skill-gap?retryWrites=true&w=majority"

# NextAuth — REQUIRED on Vercel (missing secret causes site-wide 500s)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# NEXTAUTH_URL — LOCAL DEVELOPMENT ONLY.
#
# Do NOT set this on Vercel. When it is unset, NextAuth derives the origin from
# the incoming request (x-forwarded-host / x-forwarded-proto), which is always
# correct for every deployment, preview URL, and custom domain. When it IS set,
# it wins unconditionally — including when it is stale or wrong, which silently
# breaks middleware's ability to read the session cookie.
NEXTAUTH_URL="http://localhost:3000"
