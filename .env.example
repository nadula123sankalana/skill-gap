# MongoDB Atlas connection string (official driver — no Prisma)
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/skill-gap?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/skill-gap?retryWrites=true&w=majority"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google AI Studio key (Gemini free tier) — gemini-2.5-flash or gemini-2.5-flash-lite only
GEMINI_API_KEY=""
